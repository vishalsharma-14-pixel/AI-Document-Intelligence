# Google AI Studio key (https://aistudio.google.com/apikey) - used for Gemini text-embedding-004
GOOGLE_API_KEY=

# Groq API key (https://console.groq.com/keys) - used for the answering/summarizing LLM
GROQ_API_KEY=

# Postgres (matches docker-compose service defaults, override if needed)
DATABASE_URL=postgresql+psycopg2://docintel:docintel@postgres:5432/docintel

# Redis (Celery broker + result backend)
REDIS_URL=redis://redis:6379/0

# JWT signing secret - generate your own, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local file storage (inside the backend container)
UPLOAD_DIR=/app/uploads

# Chroma vector store server (see the `chroma` service in docker-compose.yml)
CHROMA_HOST=chroma
CHROMA_PORT=8000
